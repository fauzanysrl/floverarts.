# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=floverarts_db
DB_CONNECTION_LIMIT=10

# JWT Authentication
JWT_SECRET=floverarts_super_secret_jwt_key_2026
